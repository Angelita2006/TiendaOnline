@model TiendaOnline.Models.Producto
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Crear producto nuevo";
}

<h2 class="prueba">@ViewData["Title"]</h2>
<br>
<form class="prueba" asp-action="Crear" method="post" enctype="multipart/form-data">
    <h5>Información del producto</h5>
    <div>
        <input type="file" name="ImagenFile" class="form-control" />                 
    </div> 
     <div>
        <label class="form-label" asp-for="@Model.Nombre">Nombre:</label>
        <input class="form-control" asp-for="@Model.Nombre"/>
        <span class="text-danger" asp-validation-for="@Model.Nombre"/>
    </div>
      <div>
        <label class="form-label" asp-for="@Model.Descripcion">Descripción:</label>
        <textarea class="form-control" rows="4" asp-for="@Model.Descripcion"/></textarea>
        <span class="text-danger" asp-validation-for="@Model.Descripcion"/>
    </div>
    <div>
        <label class="form-label" asp-for="@Model.Precio">Precio:</label>
        <input class="form-control" type="number" step="0.01" asp-for="@Model.Precio"/>
        <span class="text-danger" asp-validation-for="@Model.Precio"/>
    </div>
    <div>
        <label class="form-label" asp-for="@Model.Existencias">Existencias:</label>
        <input class="form-control" type="number" asp-for="@Model.Existencias"/>
        <span class="text-danger" asp-validation-for="@Model.Existencias"/>
    </div>  
    <br>
    <p><input class="btn btn-primary" type="submit" value="Añadir producto"/>
    <a class="btn btn-secondary prueba" asp-action="Index">Cancelar</a></p>
</form>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
} 