@model List<TiendaOnline.Models.Producto>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

}
<h1>Productos</h1>
<form asp-action="Index" method="get">
    <p><input class="form-control prueba" type="text" name="texto" placeholder="Buscar por nombre..." value='@ViewData["Texto"]' /></p>
    <p><input class="search-button btn btn-secondary prueba" type="submit" value="Buscar" /> <a class="btn btn-secondary prueba" type="submit" asp-action="Index">Limpiar</a></p>
</form>
<a class="btn btn-primary mb-3" asp-action="Crear">Crear nuevo producto</a>
<table class="table">
    <thead>
        <tr>
            <th>Imagen</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Existencias</th>
            <th>Editar</th>
            <th>Eliminar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td><img src="@Url.Content("~/images/" + producto.ImagenUrl)" style="heigth: auto; width: 80px;" /></td>
                <td><a asp-action="Detalles" asp-route-id="@producto.Id">@producto.Nombre</a></td>
                <td>@producto.Precio.ToString()€</td>
                <td>@producto.Existencias</td>
                <td><a class="btn btn-primary mb-3" method="get" asp-action="Editar" asp-route-id="@producto.Id">Editar</a></td>
                <td><a class="btn btn-primary mb-3 btn-danger" type="submit" name="eliminar" asp-action="Eliminar" asp-route-id="@producto.Id">Eliminar</a></td>
            </tr>
        }
    </tbody>
</table>