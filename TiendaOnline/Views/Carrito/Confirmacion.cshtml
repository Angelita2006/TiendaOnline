@model TiendaOnline.Models.Pedido
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h2>Pedido confirmado</h2>

<p>¡Gracias por tu compra! :D</p>

<p><strong>Nº Pedido:</strong> @Model.Id</p>
<p><strong>Fecha:</strong> @Model.Fecha</p>
<p><strong>Total:</strong> @Model.Total €</p>

<h4>Productos</h4>
<ul>
    @foreach (var linea in Model.LineasPedido)
    {
        <li>
            Producto: @linea.Producto.Nombre |
            Cantidad: @linea.Cantidad |
            Precio: @linea.PrecioUnitario €
        </li>
    }
</ul>