@model TiendaOnline.Models.Devolucion
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Solicitar devolución";
}

<h2 class="prueba">@ViewData["Title"]</h2>
<br>
<form class="prueba" asp-action="Crear" method="post" enctype="multipart/form-data">
    <h5>Información de la devolución</h5>
    <input type="hidden" class="form-control" asp-for="@Model.PedidoId" readonly/>
    <div>
        <label class="form-label" asp-for="@Model.MotivoDevolucion">Motivo de la devolución:</label>
        <textarea class="form-control" rows="4" asp-for="@Model.MotivoDevolucion"/></textarea>
        <span class="text-danger" asp-validation-for="@Model.MotivoDevolucion"/>
    </div>
    <br>
    <p><input class="btn btn-primary" type="submit" value="Solicitar devolución"/>
    <a class="btn btn-secondary prueba" asp-action="Index">Cancelar</a></p>
</form>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
} 