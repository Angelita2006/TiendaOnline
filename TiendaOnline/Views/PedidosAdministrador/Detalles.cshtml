@model TiendaOnline.Models.Pedido
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1>Detalles del pedido</h1>

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Número de pedido:</strong> @Model.Id</p>
        <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Total:</strong> @Model.Total €</p>

        @if (Model.Usuario != null)
        {
            <p><strong>Usuario:</strong> @Model.Usuario.UserName</p>
        }
    </div>
</div>

<h3>Líneas del pedido</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Precio unitario</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var linea in Model.LineasPedido)
        {
            <tr>
                <td><a asp-controller="Productos" asp-action="Detalles" asp-route-id="@linea.Producto.Id">@linea.Producto.Nombre</a></td>
                <td>@linea.PrecioUnitario €</td>
                <td>@linea.Cantidad</td>
                <td>@(linea.PrecioUnitario* linea.Cantidad) €</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Volver</a>